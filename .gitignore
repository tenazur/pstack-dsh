# Node / pnpm
node_modules/
*.log
.npm/
pnpm-debug.log*

# Build output is COMMITTED for a DSH plugin: a `github:` install must not run
# `prepare`, so `lib/` ships. Do not ignore lib/.
# lib/

# A repo-local scratch directory, ignored so it can be used freely as working space — the same
# role `$DSH_HOME/tmp` and `mktemp -d` play. Prefer a temp directory for anything that is truly
# throwaway; `scratch/` is for work that wants to sit beside the tree it is about.
#
# Ignoring it is not a licence to leave it dirty. An ignored directory still occupies the disk and
# still has to be cleaned by a human, so:
#   * never let the repo DEPEND on anything here. Inputs a gate needs are tracked
#     (`scripts/host-fixture/`); only outputs belong in scratch.
#   * nothing committed may cite a path under `scratch/` — a fresh clone does not have one, so the
#     citation would be unverifiable.
scratch/
*.local.*

# Pinned upstream checkout. Reconstituted by scripts/fetch-upstream.sh, never committed:
# Phase 3's diff gate compares against the pin, not against whatever a clone happens to hold.
.upstream/

# pnpm's content-addressable store, created in the workspace root by the plugin installs used
# to verify the profile layer. Cache, not artifact.
.pnpm-store/

# Per-unit worktrees. Standing order 9 (one writer per path) needs a cut worktree per parallel
# unit, and a worktree nested in the repo is otherwise seen as untracked content by every gate.
.worktrees/

# Editor / OS
.DS_Store
*.swp
.idea/
.vscode/
